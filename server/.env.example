DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="change-me-long-random-string"
CORS_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
SEED_ADMIN_PASSWORD="change-me"

# AI layer (all optional). Without ANTHROPIC_API_KEY agents use built-in heuristics.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AI_ENABLED=true
AI_AUTO_ANALYZE=true
AI_DAILY_CALL_LIMIT=500
AI_TIMEOUT_MS=20000
SLA_SWEEP_INTERVAL_SECONDS=60
